# ─── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
BASE_URL=http://localhost:3000

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kosho:kosho@localhost:5432/kosho?schema=public
# Separate DB for automated tests (docker-compose exposes it on 5433)
TEST_DATABASE_URL=postgresql://kosho:kosho@localhost:5433/kosho_test?schema=public

# ─── JWT ─────────────────────────────────────────────────────────────────
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-64-random-bytes-hex
JWT_REFRESH_SECRET=change-me-to-another-64-random-bytes-hex
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS_MOBILE=7
JWT_REFRESH_TTL_HOURS_WEB=24

# ─── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=popytchik_bot

# ─── OAuth ──────────────────────────────────────────────────────────────
# Comma-separated if multiple clients (e.g. web + Flutter use different IDs)
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=

# ─── SMS Provider (Mega.kg / Nikita) ────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_LOGIN=
SMS_API_PASSWORD=
SMS_SENDER=Popytchik

# ─── Superadmin seed (first deploy only; then forces password change) ──
SUPERADMIN_EMAIL=superadmin@popytchik.kg
SUPERADMIN_TEMP_PASSWORD=change-on-first-login

# ─── File storage (MVP: local disk) ─────────────────────────────────────
FILES_DIR=./var/files
MAX_UPLOAD_MB=5

# ─── Rate limit overrides (for tests — defaults in code match TZ §7.3) ──
# RATE_LIMIT_DISABLED=false

# ─── Swagger ────────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
