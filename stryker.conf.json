{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing scoped to the pure security-critical libs (fast, DB-free). Run: npm run test:mutation. Not part of CI — run before releases touching auth/OTP.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "mutate": ["src/lib/bcrypt.ts", "src/lib/random.ts"],
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "thresholds": { "high": 90, "low": 75, "break": 60 }
}
